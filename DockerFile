FROM python:3.11-slim

WORKDIR /app

# FastAPI、Uvicorn（サーバー）、機械学習ライブラリをインストール
RUN pip install --no-cache-dir \
    fastapi \
    uvicorn \
    sentence-transformers

COPY . .

# ビルド時にモデルをあらかじめダウンロードしておく（Cloud Runの起動を高速化するため）
RUN python -c "from sentence-transformers import SentenceTransformer; SentenceTransformer('all-MiniLM-L6-v2')"

# FastAPIを起動するコマンド
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8080"]
